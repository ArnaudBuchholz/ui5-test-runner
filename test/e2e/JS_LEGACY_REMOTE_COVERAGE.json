{
  "if": "implemented('coverage')",
  "batchId": "JS_LEGACY_REMOTE_COVERAGE",
  "batchLabel": "Legacy JS Sample accessed using --url with coverage",
  "cwd": "../sample.js",
  "url": ["http://localhost:0/test/testsuite.qunit.html"],
  "noScreenshot": null,
  "coverage": true,
  "coverageSettings": "./.nycrc.json",
  "coverageTempDir": "{{reportDir}}/.nyc_output",
  "coverageReportDir": "{{reportDir}}/coverage",
  "coverageCheckStatements": 65,
  "end": "RUNNER_EXIT_CODE={{exitCode}} NODE_OPTIONS= node ../e2e/check.mjs {{reportDir}} --pages 2 --coverage --report-uncovered"
}
