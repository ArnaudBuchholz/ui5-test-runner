{
  "if": "implemented('coverage')",
  "batchId": "JS_REMOTE_COVERAGE",
  "batchLabel": "Remote JS sample with coverage (no local mapping)",
  "url": ["http://localhost:8080/test/testsuite.qunit.html"],
  "noScreenshot": null,
  "coverage": true,
  "coverageSettings": "../sample.js/.nycrc.json",
  "coverageTempDir": "{{reportDir}}/.nyc_output",
  "coverageReportDir": "{{reportDir}}/coverage",
  "coverageCheckStatements": 65,
  "end": "RUNNER_EXIT_CODE={{exitCode}} NODE_OPTIONS= node test/e2e/check.mjs {{reportDir}} --pages 2 --coverage --report-uncovered"
}
