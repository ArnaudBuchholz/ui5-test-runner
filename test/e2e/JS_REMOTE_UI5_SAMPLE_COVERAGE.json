{
  "if": "implemented('coverage')",
  "batchId": "JS_REMOTE_UI5_SAMPLE_COVERAGE",
  "batchLabel": "Remote JS UI5 sample with coverage (experimental)",
  "url": ["https://ui5.sap.com/test-resources/sap/m/demokit/orderbrowser/webapp/test/testsuite.qunit.html"],
  "noScreenshot": null,
  "coverage": null,
  "coverageTempDir": "📂report/.nyc_output",
  "coverageReportDir": "📂report/coverage",
  "coverageProxy": null,
  "coverageProxyInclude": "/webapp/",
  "coverageProxyExclude": "/resources/|/webapp/test/",
  "disableUi5": null,
  "end": "RUNNER_EXIT_CODE={{exitCode}} NODE_OPTIONS= node test/e2e/check.mjs {{reportDir}} --coverage"
}
