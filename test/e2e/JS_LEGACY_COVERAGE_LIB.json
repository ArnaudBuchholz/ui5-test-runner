{
  "if": "implemented('coverage') && implemented('libs')",
  "batchId": "JS_LEGACY_COVERAGE_LIB",
  "batchLabel": "Legacy JS Sample lib with coverage",
  "cwd": "../sample.lib.js",
  "webapp": "./",
  "libs": [
    "sap/utr/lib=src/sap/utr/lib"
  ],  
  "noScreenshot": null,
  "coverage": true,
  "coverageSettings": "./.nycrc.json",
  "coverageTempDir": "{{reportDir}}/.nyc_output",
  "coverageReportDir": "{{reportDir}}/coverage",
  "coverageCheckStatements": 60,
  "end": "RUNNER_EXIT_CODE={{exitCode}} NODE_OPTIONS= node ../e2e/check.mjs {{reportDir}} --coverage"
}
